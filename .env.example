# ========================================================
# ExploreX Environment Configuration Template (.env.example)
# Copy this file to .env and populate your credentials.
# ========================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
ML_SERVICE_URL="http://localhost:8000"

# Supabase (Database & Authentication)
# Accepts both SUPABASE_ANON_KEY and SUPABASE_API_KEY
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_jwt_here"
SUPABASE_API_KEY="your_supabase_publishable_api_key_here"

# Google Gemini AI (Required for live AI Concierge & Autopilot)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI (Optional fallback AI provider)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# Amadeus Self-Service API (Flights & Hotels search)
# Obtain from: https://developers.amadeus.com/my-apps
AMADEUS_CLIENT_ID="your_amadeus_client_id_here"
AMADEUS_CLIENT_SECRET="your_amadeus_client_secret_here"

# Razorpay (Payment Gateway)
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"

# Resend (Transactional Email Notifications)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"

# Google Maps API (Optional - Leaflet & OpenStreetMap are active by default)
# Obtain from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY="AIzaSy_your_google_maps_key_here"
